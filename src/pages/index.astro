/* Ilustrasi jahit bergerak */
.sewing-motion {
  position: relative;
  min-height: 510px;
  overflow: hidden;
  background: #dcae82;
}

.sewing-hoop {
  position: absolute;
  top: 50px;
  left: -90px;
  width: 340px;
  height: 340px;
  border: 25px solid #f8e4cf;
  border-radius: 50%;
}

.sewing-fabric {
  position: absolute;
  right: -100px;
  bottom: -110px;
  width: 350px;
  height: 350px;
  border: 44px solid var(--wine);
  border-radius: 50%;
}

.sewing-thread {
  position: absolute;
  top: 58px;
  left: 49%;
  width: 2px;
  height: 310px;
  background: var(--wine);
  transform: rotate(16deg);
  transform-origin: top;
  animation: thread-sway 3.2s ease-in-out infinite;
}

.sewing-thread::before {
  position: absolute;
  top: 112px;
  left: -42px;
  width: 88px;
  height: 65px;
  border: 2px solid var(--wine);
  border-right: 0;
  border-bottom: 0;
  border-radius: 70% 0 0 0;
  content: "";
}

.sewing-needle {
  position: absolute;
  top: 118px;
  left: 55%;
  width: 4px;
  height: 180px;
  border-radius: 10px;
  background: #352829;
  transform: rotate(28deg);
  animation: needle-sew 3.2s ease-in-out infinite;
}

.sewing-needle::before {
  position: absolute;
  top: -8px;
  left: -4px;
  width: 10px;
  height: 10px;
  border: 2px solid #352829;
  border-radius: 50%;
  content: "";
}

.sewing-motion p {
  position: absolute;
  bottom: 58px;
  left: 40px;
  z-index: 2;
  margin: 0;
  color: var(--wine);
  font: 600 clamp(46px, 4vw, 66px) / 0.82 "Playfair Display", serif;
  letter-spacing: -0.07em;
  transform: rotate(-8deg);
}

.sewing-motion p i {
  font-weight: 500;
}

@keyframes needle-sew {
  0%,
  100% {
    transform: translateY(0) rotate(28deg);
  }

  50% {
    transform: translateY(42px) rotate(28deg);
  }
}

@keyframes thread-sway {
  0%,
  100% {
    transform: rotate(16deg);
  }

  50% {
    transform: rotate(24deg);
  }
}


