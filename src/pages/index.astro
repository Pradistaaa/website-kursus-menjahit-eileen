  height: 545px;
  overflow: hidden;
  border-radius: 180px 180px 8px 8px;
  box-shadow: 22px 24px 0 rgba(103, 29, 49, 0.16);
}

.hero-photo img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center;
  filter: saturate(0.82) contrast(1.04);
}

.hero-photo-overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(
    180deg,
    rgba(103, 29, 49, 0.05),
    rgba(103, 29, 49, 0.46)
  );
}

.hero-photo-label {
  position: absolute;
  left: 25px;
  bottom: 23px;
  color: #fff8ee;
  font: italic 22px 'Playfair Display', serif;
}

.hero-photo-label span {
  color: #f3c28b;
  margin-right: 8px;
}

.map-wrap {
  height: 360px;
  margin-top: 58px;
  overflow: hidden;
  border: 1px solid rgba(255, 255, 255, 0.25);
}

.map-wrap iframe {
  width: 100%;
  height: 100%;
  border: 0;
  filter: grayscale(0.7) sepia(0.18) contrast(1.05);
}

.whatsapp-float {
  position: fixed;
  z-index: 20;
  right: 22px;
  bottom: 22px;
  display: flex;
  align-items: center;
  gap: 9px;
  padding: 14px 18px;
  background: #25d366;
  color: #12361f;
  border-radius: 999px;
  box-shadow: 0 12px 28px rgba(20, 75, 40, 0.26);
  font-size: 12px;
  transition: transform 0.2s ease;
}

.whatsapp-float:hover {
